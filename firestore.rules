rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de cada usuario (users/{uid}): guarda su correo, si ya ha sido
    // aprobado por el administrador ("aprobado") y si es la cuenta admin
    // ("esAdmin"). Se usa para controlar quién puede usar el resto de la app.
    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.esAdmin == true;
    }
    function estaAprobado(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.aprobado == true;
    }

    match /users/{uid} {
      // Cada usuario puede leer su propio perfil (para saber si ya tiene acceso).
      // El administrador puede leer y listar todos los perfiles, para ver quién
      // se ha registrado y darle acceso.
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());

      // Al registrarse, cada usuario crea su propio perfil, pero SIEMPRE con
      // aprobado:false y esAdmin:false: nadie puede auto-aprobarse ni
      // auto-nombrarse administrador desde la app.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.aprobado == false
        && request.resource.data.esAdmin == false;

      // Solo el administrador puede aprobar/revocar cuentas o dar el rol admin.
      allow update, delete: if esAdmin();

      // Banco de preguntas de cada usuario: solo su dueño, y solo si ya está
      // aprobado por el administrador.
      match /testQuestions/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid && estaAprobado(uid);
      }
    }

    // Cualquier otra ruta queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
