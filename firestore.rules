rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // UID de la cuenta admin (Authentication > Users > columna "User UID"). Debe ser
    // EXACTAMENTE el mismo valor que ADMIN_UID en index.html.
    function esAdmin() {
      return request.auth != null && request.auth.uid == "teAS34tRMVeWGi6qJ0EW59YVV1W2";
    }

    // Banco de preguntas único, guardado en users/{ADMIN_UID}/testQuestions/{idPregunta}.
    // - La cuenta admin puede leer y escribir (crear, editar, borrar preguntas).
    // - Cualquier otra cuenta autenticada solo puede LEER (practicar), nunca escribir.
    match /users/{uid}/testQuestions/{questionId} {
      allow read: if request.auth != null && uid == "teAS34tRMVeWGi6qJ0EW59YVV1W2";
      allow write: if esAdmin() && uid == "teAS34tRMVeWGi6qJ0EW59YVV1W2";
    }

    // Cualquier otra ruta (incluido el banco propio de cuentas no-admin, que ya no
    // se usa) queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
